# ==============================================================================
# CORTEX — Environment Variables Reference
# Oracle Cloud Always Free Deployment (https://friday-universe.duckdns.org)
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is listed in .gitignore.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # production | development
DEBUG=false
PORT=8000
HOST=0.0.0.0

# ── Storage ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
# POSTGRES_DSN=postgresql+asyncpg://cortex:password@localhost:5432/cortex_db

# SQLite (default — used locally and in CI)
POSTGRES_DSN=sqlite+aiosqlite:////app/data/cortex.db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_EVENT_STREAM=cortex:events:stream
REDIS_CONSUMER_GROUP=cortex-worker-group

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_64_char_random_hex_string
CORTEX_API_KEY=replace_with_a_secure_64_char_random_hex_string

# ── FRIDAY Universe Private Mesh (Oracle Cloud Docker Network: friday_mesh) ───
# These are the internal container DNS names — never public URLs.
FRIDAY_API_URL=http://friday:10000
FRIDAY_API_KEY=replace_with_friday_shared_key

MEMORA_URL=http://memora:8000
MEMORA_API_KEY=replace_with_memora_api_key

INFERENCE_URL=http://inference:8000
INFERENCE_API_KEY=replace_with_inference_api_key

STRATEX_URL=http://stratex:8000
STRATEX_API_KEY=replace_with_stratex_api_key

INTELX_URL=http://intelx:8000
INTELX_API_KEY=replace_with_intelx_api_key

FUTURIS_URL=http://futuris:8000
FUTURIS_API_KEY=replace_with_futuris_api_key

FORGE_URL=http://forge:8000
FORGE_API_KEY=replace_with_forge_api_key

SENTINEL_URL=http://sentinel:8000
SENTINEL_API_KEY=replace_with_sentinel_api_key

# ── Mode ─────────────────────────────────────────────────────────────────────
# MOCK_MODE mocks external side-effects only (Email, SMS, CRM, Payments).
# Set to false in production for live integrations.
MOCK_MODE=true

# ── External Integrations (Optional) ─────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

HUBSPOT_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ZENDESK_SUBDOMAIN=
ZENDESK_API_TOKEN=
ZENDESK_EMAIL=

# ── AI Universe (Deliberation / Reasoning Layer) ──────────────────────────────
AI_UNIVERSE_BASE_URL=https://api.ai-universe.dev
AI_UNIVERSE_API_KEY=your_ai_universe_api_key

# ── Dashboard ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CORTEX_API_URL=https://friday-universe.duckdns.org/cortex

# ── Dev Conveniences (never set in production) ────────────────────────────────
# CORTEX_DEV_AUTH_BYPASS=true   # Synthetic cortex_admin identity for local dev
