# ==============================================================================
# CORTEX — Environment Variables Reference
# Oracle Cloud Always Free Deployment (https://friday-universe.duckdns.org)
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is listed in .gitignore.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # production | development
DEBUG=false
PORT=8000
HOST=0.0.0.0

# ── Storage ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production). Set your own credentials here —
# never hardcode them in source or commit a real .env.
# POSTGRES_HOST=your-postgres-host
# POSTGRES_PORT=5432
# POSTGRES_USER=cortex_user
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=cortex_db
# DATABASE_URL=postgresql+asyncpg://cortex_user:change-me@your-postgres-host:5432/cortex_db
# POSTGRES_DSN=postgresql+asyncpg://cortex_user:change-me@your-postgres-host:5432/cortex_db

# SQLite (default — used locally and in CI). The path is made absolute and the
# file is durable across restarts. Leave CORTEX_SQLITE_TMPFS unset in production;
# set it to true only for disposable/ephemeral deployments (uses /dev/shm).
POSTGRES_DSN=sqlite+aiosqlite:////app/data/cortex.db
# CORTEX_SQLITE_TMPFS=false

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_EVENT_STREAM=cortex:events:stream
REDIS_CONSUMER_GROUP=cortex-worker-group

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_64_char_random_hex_string
CORTEX_API_KEY=replace_with_a_secure_64_char_random_hex_string

# ── FRIDAY Universe Private Mesh (Oracle Cloud Docker Network: friday_mesh) ───
# These are the internal container DNS names — never public URLs.
FRIDAY_API_URL=http://friday:10000
FRIDAY_API_KEY=replace_with_friday_shared_key
# Comma-separated tenants FRIDAY may delegate commands into. Required in production.
FRIDAY_ALLOWED_TENANTS=tenant_one,tenant_two

MEMORA_URL=http://memora:8000
MEMORA_API_KEY=replace_with_memora_api_key

INFERENCE_URL=http://inference:8000
INFERENCE_API_KEY=replace_with_inference_api_key

STRATEX_URL=http://stratex:8000
STRATEX_API_KEY=replace_with_stratex_api_key

INTELX_URL=http://intelx:8000
INTELX_API_KEY=replace_with_intelx_api_key

FUTURIS_URL=http://futuris:8000
FUTURIS_API_KEY=replace_with_futuris_api_key

FORGE_URL=http://forge:8000
FORGE_API_KEY=replace_with_forge_api_key

SENTINEL_URL=http://sentinel:8000
SENTINEL_API_KEY=replace_with_sentinel_api_key

# ── Mode ─────────────────────────────────────────────────────────────────────
# MOCK_MODE mocks external side-effects only (Email, SMS, CRM, Payments).
# Set to false in production for live integrations.
MOCK_MODE=true

# ── External Integrations (Optional) ─────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

HUBSPOT_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ZENDESK_SUBDOMAIN=
ZENDESK_API_TOKEN=
ZENDESK_EMAIL=

# ── Inference (Canonical Model / Reasoning Gateway) ───────────────────────────
INFERENCE_BASE_URL=http://inference:8000
INFERENCE_API_KEY=replace_with_internal_inference_service_key
# Legacy names are accepted only during migration; do not add old hosted endpoints.

# ── Dashboard ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CORTEX_API_URL=https://friday-universe.duckdns.org/cortex

# ── Dev Conveniences (never set in production) ────────────────────────────────
# CORTEX_DEV_AUTH_BYPASS=true   # Synthetic cortex_admin identity for local dev

# --- AGENT 10 VYRALX MESH ---
VYRALX_URL=http://vyralx:8000
VYRALX_API_KEY=
