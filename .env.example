# ==============================================================================
# NEXUS Operations Intelligence Platform - Environment Variables Template
# ==============================================================================

# Application & API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Storage & Caching
POSTGRES_DSN=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus_db
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus_db
REDIS_URL=redis://localhost:6379/0
REDIS_EVENT_STREAM=nexus:events:stream
REDIS_CONSUMER_GROUP=nexus-worker-group

# Security & Authentication
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production
NEXT_PUBLIC_OPERATOR_TOKEN=mock_operator_jwt_token_123

# Autonomous Intelligence & Reasoning Engine
AI_UNIVERSE_BASE_URL=https://api.ai-universe.dev
AI_UNIVERSE_API_KEY=live_ai_universe_secret_key_here

# Tool Execution & Integrations
MOCK_MODE=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
CRM_API_ENDPOINT=https://api.hubspot.com/v3
CRM_API_KEY=live_hubspot_api_key_here

# Dashboard
NEXT_PUBLIC_NEXUS_API_URL=http://localhost:8000
