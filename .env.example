# ==============================================================================
# CORTEX Operations Intelligence Platform - Environment Variables Configuration
# ==============================================================================

# Application & API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Storage & Caching (PostgreSQL & Redis Streams)
POSTGRES_DSN=postgresql+asyncpg://cortex:cortex@localhost:5432/cortex_db
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortex_db
REDIS_URL=redis://localhost:6379/0
REDIS_EVENT_STREAM=cortex:events:stream
REDIS_CONSUMER_GROUP=cortex-worker-group

# Security & Authentication (OIDC / JWT)
JWT_SECRET=replace_with_secure_random_jwt_secret_in_prod
NEXT_PUBLIC_OPERATOR_TOKEN=mock_operator_jwt_token_123

# Autonomous Intelligence & Reasoning (AI Universe Deliberation Layer)
AI_UNIVERSE_BASE_URL=https://api.ai-universe.dev
AI_UNIVERSE_API_KEY=your_ai_universe_api_key

# Tool Execution & Side-Effects Mode
# NOTE: MOCK_MODE only mocks external network side-effects (Email, SMS, CRM, Payments).
# Internal deterministic intelligence, identity, scoring, and policy evaluation always run live.
MOCK_MODE=true

# ------------------------------------------------------------------------------
# Integration Connectors (Optional per Integration Tier)
# ------------------------------------------------------------------------------

# SendGrid (Email Connector)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@cortex.dev

# Twilio (SMS & Voice Connector)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# HubSpot (CRM Connector)
HUBSPOT_API_KEY=

# Calendly / Google Calendar (Calendar Connector)
CALENDLY_API_KEY=

# Stripe (Payments Connector)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Zendesk (Support Ticketing Connector)
ZENDESK_SUBDOMAIN=
ZENDESK_API_TOKEN=
ZENDESK_EMAIL=

# Master API Key
CORTEX_API_KEY=cortex_api

# FRIDAY Cross-System Integration (Shared Service Key)
FRIDAY_API_KEY=friday_api
FRIDAY_API_URL=http://localhost:9000

# FRIDAY Universe Peer Microservices Configuration
INFERENCE_URL=https://inference-3i2b.onrender.com
INFERENCE_API_KEY=inference_api

MEMORA_URL=https://memora-9zr9.onrender.com
MEMORA_API_KEY=memora_api

STRATEX_URL=https://stratex-ucjz.onrender.com
STRATEX_API_KEY=stratex_api

INTELX_URL=https://intelx-3cz1.onrender.com
INTELX_API_KEY=intelx_api

FUTURIS_URL=https://futuris-x4f4.onrender.com
FUTURIS_API_KEY=futuris_api

FORGE_URL=http://localhost:8001
FORGE_API_KEY=forge_api

SENTINEL_URL=http://localhost:8003
SENTINEL_API_KEY=sentinel_api

# Dashboard Configuration
NEXT_PUBLIC_CORTEX_API_URL=http://localhost:8000
NEXT_PUBLIC_CORTEX_API_URL=https://cortex-qifr.onrender.com
