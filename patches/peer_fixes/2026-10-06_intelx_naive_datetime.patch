--- a/intelx/db/models.py
+++ b/intelx/db/models.py
@@ -50,6 +50,19 @@ def utc_now() -> datetime:
     return datetime.now(UTC)
 
 
+def ensure_utc(value: datetime | None) -> datetime | None:
+    """Attach UTC to a datetime read back from the database.
+
+    SQLite has no timezone type: a column declared ``DateTime(timezone=True)`` still comes
+    back naive. Arithmetic against ``datetime.now(UTC)`` then raises
+    ``TypeError: can't subtract offset-naive and offset-aware datetimes`` (observed as a 500
+    from GET /api/v1/friday/research/{run_id} while a run was in flight).
+    """
+    if value is None:
+        return None
+    return value if value.tzinfo is not None else value.replace(tzinfo=UTC)
+
+
 class ResearchRun(Base):
     """Execution container for an end-to-end intelligence investigation."""
 
